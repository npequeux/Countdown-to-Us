<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CountdownToUs.MainPage">

    <Grid>
        <Image x:Name="BackgroundImage" Source="background" Aspect="AspectFill" SemanticProperties.Description="Background photo" />
        <BoxView Color="#80000000" />
        <VerticalStackLayout Spacing="16" Padding="24,32">

            <Label Text="COUNTDOWN TO US" FontSize="Title" HorizontalOptions="Center" TextColor="White" />
            <Label x:Name="TargetDateLabel" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White" Opacity="0.9" />

            <Border Stroke="Transparent" BackgroundColor="#59FFFFFF" Padding="10,8" StrokeShape="RoundRectangle 12">
                <HorizontalStackLayout Spacing="14" HorizontalOptions="Center">
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="DaysLabel" Text="0" FontSize="34" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="DAYS" FontSize="12" Opacity="0.8" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="HoursLabel" Text="00" FontSize="34" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="HOURS" FontSize="12" Opacity="0.8" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="MinsLabel" Text="00" FontSize="34" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="MINUTES" FontSize="12" Opacity="0.8" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="SecsLabel" Text="00" FontSize="34" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="SECONDS" FontSize="12" Opacity="0.8" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <Label x:Name="StatusLabel" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White" />

            <Border Stroke="Transparent" BackgroundColor="#CC222222" Padding="14,10" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Set countdown date" FontAttributes="Bold" />
                    <DatePicker x:Name="DateInput" Format="yyyy-MM-dd" BackgroundColor="#FFEFEFEF" />
                    <TimePicker x:Name="TimeInput" BackgroundColor="#FFEFEFEF" />
                    <Button Text="Update countdown" Clicked="OnSetDateClicked" HorizontalOptions="FillAndExpand" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Choose background photo" Clicked="OnPickPhotoClicked" HorizontalOptions="FillAndExpand" BackgroundColor="#59FFFFFF" />

        </VerticalStackLayout>
    </Grid>

</ContentPage>