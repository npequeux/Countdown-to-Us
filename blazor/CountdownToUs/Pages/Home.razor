@page "/"
@using System.Timers
@using System.Linq
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Countdown to Us</PageTitle>

<div class="container">
    <h1>@CountdownTitle</h1>

    <div class="image-container">
        <img src="@CurrentImageSrc" alt="Paradise island" class="us-image" />
        <div class="slideshow-controls" style="display:@(ActiveImages.Count > 1 ? "flex" : "none")">
            <button class="slide-btn" @onclick="PrevSlide" aria-label="@T("Previous Slide")">\u2190</button>
            <button class="slide-btn" @onclick="NextSlide" aria-label="@T("Next Slide")">\u2192</button>
        </div>
    </div>

    <div class="countdown-container">
        <h2>@CountdownTitle</h2>
        <div class="countdown">
            <div class="countdown-item">
                <span class="countdown-value">@Years</span>
                <span class="countdown-label">Years</span>
            </div>
            <div class="countdown-item">
                <span class="countdown-value">@Months</span>
                <span class="countdown-label">Months</span>
            </div>
            <div class="countdown-item">
                <span class="countdown-value">@Days</span>
                <span class="countdown-label">Days</span>
            </div>
            <div class="countdown-item">
                <span class="countdown-value">@Hours</span>
                <span class="countdown-label">Hours</span>
            </div>
            <div class="countdown-item">
                <span class="countdown-value">@Minutes</span>
                <span class="countdown-label">Minutes</span>
            </div>
            <div class="countdown-item">
                <span class="countdown-value">@Seconds</span>
                <span class="countdown-label">Seconds</span>
            </div>
        </div>
    </div>

    <div class="countdown-container">
        <h2>@CountdownTitle2</h2>
        <div class="countdown">
            <div class="countdown-item">
                <span class="countdown-value">@Years2</span>
                <span class="countdown-label">Years</span>
            </div>
            <div class="countdown-item">
                <span class="countdown-value">@Months2</span>
                <span class="countdown-label">Months</span>
            </div>
            <div class="countdown-item">
                <span class="countdown-value">@Days2</span>
                <span class="countdown-label">Days</span>
            </div>
            <div class="countdown-item">
                <span class="countdown-value">@Hours2</span>
                <span class="countdown-label">Hours</span>
            </div>
            <div class="countdown-item">
                <span class="countdown-value">@Minutes2</span>
                <span class="countdown-label">Minutes</span>
            </div>
            <div class="countdown-item">
                <span class="countdown-value">@Seconds2</span>
                <span class="countdown-label">Seconds</span>
            </div>
        </div>
    </div>

    </div>

    @code {
        private string _targetDateStr = "2029-10-01";
        private string _targetDateStr2 = "2030-10-01";
        private DateTimeOffset _targetDate => DateTimeOffset.Parse(_targetDateStr);
        private DateTimeOffset _targetDate2 => DateTimeOffset.Parse(_targetDateStr2);

        private int Years {
            get {
                return (int)_targetDate.Subtract(DateTime.Now).TotalDays / 365.25;
            }
        }

        private int Months {
            get {
                return (_targetDate.Subtract(DateTime.Now).TotalDays / 365.25).ToString("0.").Split(".")[1].PadRight(2, '0').Substring(0, 2) != "00" ? (int)((_targetDate.Subtract(DateTime.Now).TotalDays / 365.25).ToString("0.").Split(".")[1].PadRight(2, '0').Substring(0, 2)) : 0;
            }
        }

        private int Days {
            get {
                return (int)_targetDate.Subtract(DateTime.Now).TotalDays % 365;
            }
        }

        private int Hours {
            get {
                var span = _targetDate - DateTimeOffset.UtcNow;
                return (int)span.TotalHours % 24;
            }
        }

        private int Minutes {
            get {
                return (int)_targetDate.Subtract(DateTime.Now).TotalMinutes % 60;
            }
        }

        private int Seconds {
            get {
                return (int)_targetDate.Subtract(DateTime.Now).TotalSeconds % 60;
            }
        }

        private int Years2 {
            get {
                return (int)(_targetDate2.Subtract(DateTime.Now).TotalDays / 365.25);
            }
        }

        private int Months2 {
            get {
                return (_targetDate2.Subtract(DateTime.Now).TotalDays / 365.25).ToString("0.").Split(".")[1].PadRight(2, '0').Substring(0, 2) != "00" ? (int)((_targetDate2.Subtract(DateTime.Now).TotalDays / 365.25).ToString("0.").Split(".")[1].PadRight(2, '0').Substring(0, 2)) : 0;
            }
        }

        private int Days2 {
            get {
                return (int)_targetDate2.Subtract(DateTime.Now).TotalDays % 365;
            }
        }

        private int Hours2 {
            get {
                var span = _targetDate2 - DateTimeOffset.UtcNow;
                return (int)span.TotalHours % 24;
            }
        }

        private int Minutes2 {
            get {
                return (int)_targetDate2.Subtract(DateTime.Now).TotalMinutes % 60;
            }
        }

        private int Seconds2 {
            get {
                return (int)_targetDate2.Subtract(DateTime.Now).TotalSeconds % 60;
            }
        }

        private string CountdownTitle = "Countdown to US Presidential Election 2029";
        private string CountdownTitle2 = "Countdown to US Presidential Election 2030";
        private string CurrentImageSrc = "/images/paradise-island.jpg";
        private List<string> ActiveImages = new() {
            "/images/paradise-island.jpg",
            "/images/tropical-beach.jpg",
            "/images/sunset-vista.jpg"
        };

        private int CurrentImageIndex => 0;

        private Func<Task> PrevSlide = () => {
            if (ActiveImages.Count > 1) {
                CurrentImageIndex--;
                if (CurrentImageIndex < 0) CurrentImageIndex = ActiveImages.Count - 1;
            }
            StateHasChanged();
            return Task.CompletedTask;
        };

        private Func<Task> NextSlide = () => {
            if (ActiveImages.Count > 1) {
                CurrentImageIndex++;
                if (CurrentImageIndex >= ActiveImages.Count) CurrentImageIndex = 0;
            }
            StateHasChanged();
            return Task.CompletedTask;
        };

        protected override async Task OnInitializedAsync() {
            var timer = new Timer(1000);
            timer.Elapsed += (sender, e) => InvokeAsync(StateHasChanged);
            timer.Start();
            await JS.InvokeVoidAsync("blazor.registerCountdownUpdate", "update-countdown", () => StateHasChanged());
            await JS.InvokeVoidAsync("blazor.registerCountdownUpdate", "update-countdown2", () => StateHasChanged());
            await base.OnInitializedAsync();
        }

        public async ValueTask DisposeAsync() {
            var timer = new Timer(1000);
            timer?.Stop();
            timer?.Dispose();
            await JS.InvokeVoidAsync("blazor.unregisterCountdownUpdate", "update-countdown");
            await JS.InvokeVoidAsync("blazor.unregisterCountdownUpdate", "update-countdown2");
        }
    }
